apiVersion: v1
kind: Secret
metadata:
  name: privacymesh-secrets
  namespace: privacymesh
  labels:
    app.kubernetes.io/name: privacymesh
type: Opaque
stringData:
  POSTGRES_PASSWORD: "YOUR_POSTGRES_SUPERUSER_PASSWORD"
  APP_DB_PASSWORD: "YOUR_APP_DB_PASSWORD"
  JWT_SECRET_KEY: "YOUR_64_CHAR_HEX_JWT_SECRET_KEY"
  GRAFANA_ADMIN_PASSWORD: "YOUR_GRAFANA_ADMIN_PASSWORD"
