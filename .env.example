# =====================================================================
# PrivacyMesh - Environment Variables Template
# Copy this file to .env and configure values before starting services.
# NEVER commit real production secrets or credentials to version control.
# =====================================================================

# PostgreSQL Database Configuration (DBA / Bootstrap Superuser)
POSTGRES_USER=privacy_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=privacymesh

# Backend FastAPI Runtime Configuration (Least-Privilege Role: privacy_app)
APP_DB_USER=privacy_app
APP_DB_PASSWORD=replace_with_strong_runtime_password
DATABASE_URL=postgresql+psycopg://privacy_app:replace_with_strong_runtime_password@db:5432/privacymesh

# JWT Secret Key (generate using: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=replace_with_64_character_hex_secret_key

# Allowed CORS Origins (comma-separated list for local frontend dev servers)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Frontend Vite Configuration
VITE_API_URL=http://localhost:8000

# Grafana Admin Credentials (required — no default password is provided)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password
