# =====================================================================
# PrivacyMesh - Environment Variables Template
# Copy this file to .env and configure values before starting services.
# NEVER commit real production secrets or credentials to version control.
# =====================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=privacy_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=privacymesh

# Backend FastAPI Configuration
# When connecting from Docker host to container PostgreSQL:
# host port is 5433 (e.g., localhost:5433).
# Within Docker Compose network, use db:5432.
DATABASE_URL=postgresql+psycopg://privacy_user:replace_with_strong_password@db:5432/privacymesh

# JWT Secret Key (generate using: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=replace_with_64_character_hex_secret_key

# Allowed CORS Origins (comma-separated list for local frontend dev servers)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite Configuration (optional override)
# VITE_API_URL=http://localhost:8000
